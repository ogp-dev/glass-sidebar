# Glass Sidebar — Docker Compose environment.
# Copy this file to .env (next to docker-compose.yml) and fill in your keys:
#
#   cp .env.docker.example .env
#   docker compose up
#
# Get the keys from:
#   Anthropic — https://console.anthropic.com/
#   Deepgram  — https://console.deepgram.com/
#   Exa       — https://dashboard.exa.ai/

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
EXA_API_KEY=

# Auth is bypassed in the Docker setup (DEV_MODE=true), so these are optional.
# CLERK_JWKS_URL=
# CLERK_ISSUER=
